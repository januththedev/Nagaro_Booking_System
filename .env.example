# ---------------------------------------------------------------------------
# Nagaro Space Booking System - environment configuration
# Copy to `.env` for local development. Never commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# HTTP
PORT=4173
HOST=127.0.0.1
NODE_ENV=development

# Absolute URL used in notification emails
NAGARO_BASE_URL=http://127.0.0.1:4173

# Database and uploads (defaults shown; omit to use defaults)
# NAGARO_DB_PATH=D:\Nagaro_Bookinag_System\data\nagaro.db
# NAGARO_UPLOAD_DIR=D:\Nagaro_Bookinag_System\storage\uploads

# ---------------------------------------------------------------------------
# First administrator
# Applied only on an empty database. Ignored once any administrator exists.
# Needing both variables set for the bootstrap to run is deliberate.
# ---------------------------------------------------------------------------
# NAGARO_BOOTSTRAP_ADMIN_EMAIL=ops@nagaro.example
# NAGARO_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-boot
# NAGARO_BOOTSTRAP_ADMIN_NAME=Nagaro Operations

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP_HOST the system still saves every inquiry and
# records email_status as NOT_CONFIGURED. It never claims an email was sent.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
SMTP_FROM=no-reply@nagaro.local
# Where booking enquiries are delivered
# NAGARO_ADMIN_NOTIFICATION_EMAIL=bookings@nagaro.example

# One-time staff provisioning without an interactive prompt (create-admin CLI):
# NAGARO_NEW_ADMIN_EMAIL=ops@nagaro.example
# NAGARO_NEW_ADMIN_NAME=Nagaro Operations
# NAGARO_NEW_ADMIN_PASSWORD=choose-a-strong-password-first
# Usage: NAGARO_NEW_ADMIN_EMAIL=... NAGARO_NEW_ADMIN_PASSWORD=... npm run admin:create
# The bootstrap variables above (NAGARO_BOOTSTRAP_ADMIN_*) only apply on first
# boot against an empty database; both paths are idempotent and never overwrite
# an existing account.

# Local email testing without a mail server (nodemailer json/stream transport)
# NAGARO_MAIL_TRANSPORT=json

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Salt for hashing IP addresses in the audit log and rate limiter.
# Set a long random value in production.
NAGARO_IP_SALT=change-me-in-production
# Set to 1 when running behind a reverse proxy you control
NAGARO_TRUST_PROXY=0
# Set to 1 to force the Secure cookie flag (e.g. TLS terminated upstream)
NAGARO_FORCE_SECURE_COOKIES=0

# ---------------------------------------------------------------------------
# Database (production: Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL is the pooled Supabase PostgreSQL connection used at runtime.
# For Vercel, use the transaction-pooler URL and require TLS. DIRECT_URL is the
# direct/session connection used only by the migration command.
# DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres?sslmode=require
#
# Ephemeral preview databases (explicit opt-in only, nothing persists):
# Set NAGARO_ALLOW_EPHEMERAL_SQLITE=1 only for throwaway Preview demos.
# Never enable it where real bookings matter.
# NAGARO_ALLOW_EPHEMERAL_SQLITE=1

# ---------------------------------------------------------------------------
# Image storage (production: Vercel Blob)
# ---------------------------------------------------------------------------
# When BLOB_READ_WRITE_TOKEN is set, uploaded photos go to Vercel Blob.
# Otherwise they are stored on the local filesystem (development).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# NAGARO_DEMO_ADMIN_EMAIL=admin@nagaro.local
# NAGARO_DEMO_ADMIN_PASSWORD=NagaroDemo2026
